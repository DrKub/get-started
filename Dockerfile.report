# Offline report image: `docker compose run --rm report`.
# The repository is mounted at /work; only the plotting dependencies live here.
FROM python:3.12-slim

COPY viz/requirements.txt /tmp/viz-requirements.txt
RUN pip install --no-cache-dir -r /tmp/viz-requirements.txt

WORKDIR /work
ENTRYPOINT ["sh", "-c", "python -m analysis && python -m viz"]
