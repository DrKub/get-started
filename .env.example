# Copy to .env if you want docker compose to interpolate these.
# .env is gitignored. Do not put a keypair in this file; mount the key file.

# Mainnet JSON-RPC. Public RPC works for the dry-run. A private RPC is kinder
# to getClusterNodes / getSlotLeaders / later getBlock collection.
RPC_URL=https://api.mainnet-beta.solana.com

# Hard ceiling is 0.05 SOL. Lower values are allowed; higher values are rejected.
SPEND_CAP_SOL=0.05

LOOKAHEAD_SLOTS=16000
MIN_LEAD_SLOTS=16
TARGET_VALIDATORS=6
MIN_CLIENT_FAMILIES=3
TPU_REPEATS=2
RPC_REPEATS=1

# Path inside the container after you mount a Solana CLI id.json.
# Leaving this empty keeps the dry-run on the placeholder pubkey.
# KEYPAIR_PATH=/keys/id.json

# Optional stable id for memo tags. Default is derived from epoch and time.
# EXPERIMENT_ID=e1071-manual
