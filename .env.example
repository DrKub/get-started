# Copy to .env if you want docker compose to interpolate these.
# .env is gitignored. Do not put a keypair or an API token in git.

# dry-run (default) or live. MODE=live is the same switch as `python -m measure run --live`.
# Anything else stays on dry-run.
MODE=dry-run

# Mainnet JSON-RPC. A key in the query string stays in the environment
# and is stripped from logs. Public api.mainnet-beta.solana.com returns
# HTTP 429 under getSignatureStatuses / getBlock; a keyed URL is the
# one to use for a live run.
RPC_URL=https://api.mainnet-beta.solana.com

# Optional websocket for slotSubscribe. When unset, derived from RPC_URL
# (https -> wss). Set this when the provider's socket host differs.
# WS_URL=wss://your-keyed-mainnet-rpc

# Hard ceiling is 0.05 SOL. Lower values are allowed; higher values are rejected.
SPEND_CAP_SOL=0.05

# Host path to a Solana CLI id.json. Compose mounts it read-only at /keys/id.json.
# Leave empty for a dry-run; the process generates an ephemeral key.
# KEYPAIR_PATH=/absolute/path/to/id.json

# Optional. When set, software_client from validators.app replaces RPC clientId.
# VALIDATORS_APP_TOKEN=

LOOKAHEAD_SLOTS=16000
# ~30s of lead at a 215 ms slot. Planning itself takes about 15s.
MIN_LEAD_SLOTS=150
# Copies of each probe burst written to that leader's TPU. 1 keeps arrival order obvious.
TPU_COPIES=1
TARGET_VALIDATORS=6
MIN_CLIENT_FAMILIES=3
# ascending (lowest fee first; both committed runs), descending, or shuffled.
# shuffled draws a per-ladder permutation with |tau(fee, send)| <= 1/3, so fee
# order and arrival order make different predictions. Not yet run on mainnet.
SEND_ORDER=ascending
# Seed for shuffled. Default: CRC32 of the run id. Recorded in manifest.json.
# SEND_ORDER_SEED=
# both, or conflict (no non-conflict payers: no funding, no rent, no sweep).
LADDERS=both
# Live only: fetch getBlock for the landed slots after the send.
COLLECT=1
